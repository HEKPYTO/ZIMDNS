#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_zig=$(git diff --cached --name-only --diff-filter=ACM -- '*.zig')
if [ -n "$staged_zig" ]; then
    zig fmt --check $staged_zig
fi

# CI (.github/workflows/ci.yml) runs the full baseline on every push, so the
# local build only guards the commits that can change what it produces.
staged_build=$(git diff --cached --name-only --diff-filter=ACM -- '*.zig' '*.zig.zon')
if [ -n "$staged_build" ]; then
    zig build
fi
